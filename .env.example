# Copy this file to `.env` and fill in your key for LOCAL runs.
# In GitHub Actions these are provided by repository secrets instead.
ANTHROPIC_API_KEY=

# Residential proxy for transcript fetches (needed on cloud IPs; optional locally).
# Recommended: Webshare residential proxy — the library rotates its pool for you.
WEBSHARE_PROXY_USERNAME=
WEBSHARE_PROXY_PASSWORD=

# Or any generic HTTP/HTTPS proxy instead of Webshare:
# YTDIGEST_PROXY_HTTP_URL=http://user:pass@host:port
# YTDIGEST_PROXY_HTTPS_URL=http://user:pass@host:port
